#!/bin/sh
set -eu

BIN_DIR=${0%/*}
RUNTIME_RESOLVER=$BIN_DIR/ordax-proof-runtime.sh
SCRIPT=/srv/ordax-system/diagnostics/mvp_surface_smoke.py

[ -x /bin/busybox ] || {
    echo "ordax-mvp-smoke: /bin/busybox unavailable" >&2
    exit 2
}
[ -r "$RUNTIME_RESOLVER" ] || {
    echo "ordax-mvp-smoke: runtime resolver unavailable: $RUNTIME_RESOLVER" >&2
    exit 2
}
. "$RUNTIME_RESOLVER"
resolve_ordax_proof_runtime_root || exit 2

[ -x "$RUNTIME_ROOT/usr/bin/python3" ] || {
    echo "ordax-mvp-smoke: active WebKit runtime Python unavailable: $RUNTIME_ROOT/usr/bin/python3" >&2
    exit 2
}
[ -r "$RUNTIME_ROOT$SCRIPT" ] || {
    echo "ordax-mvp-smoke: proof collector is not mounted in the active runtime; keep the Surface running and retry" >&2
    exit 2
}
[ -d "$RUNTIME_ROOT/proc" ] && [ -d "$RUNTIME_ROOT/run" ] && [ -d "$RUNTIME_ROOT/srv/ordax-system" ] || {
    echo "ordax-mvp-smoke: active Surface runtime bindings are unavailable" >&2
    exit 2
}

echo "ordax-mvp-smoke: proof profile=$ORDAX_PROOF_PROFILE runtime=$RUNTIME_ROOT" >&2
exec /bin/busybox chroot "$RUNTIME_ROOT" /usr/bin/python3 "$SCRIPT" "$@"
