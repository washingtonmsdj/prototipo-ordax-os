#!/bin/sh
set -eu

BIN_DIR=${0%/*}
PROOF_RUNTIME_LIB=$BIN_DIR/../lib/physical-proof-runtime.sh
COLLECTOR=/srv/ordax-system/diagnostics/mvp_surface_smoke.py

[ -r "$PROOF_RUNTIME_LIB" ] || {
    echo "ordax-mvp-smoke: physical proof runtime helper unavailable" >&2
    exit 2
}
. "$PROOF_RUNTIME_LIB"

select_ordax_physical_proof_runtime "ordax-mvp-smoke"
exec_ordax_physical_proof "ordax-mvp-smoke" "$COLLECTOR" "$@"
