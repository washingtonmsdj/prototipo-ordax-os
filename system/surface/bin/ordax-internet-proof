#!/bin/sh
set -eu

case "$0" in
    */*) BIN_DIR=${0%/*} ;;
    *) BIN_DIR=. ;;
esac
PROOF_RUNTIME_LIB=$BIN_DIR/../lib/physical-proof-runtime.sh
COLLECTOR=/srv/ordax-system/diagnostics/internet_native_physical_proof.py

[ -r "$PROOF_RUNTIME_LIB" ] || {
    echo "ordax-internet-proof: physical proof runtime helper unavailable" >&2
    exit 2
}
. "$PROOF_RUNTIME_LIB"

select_ordax_physical_proof_runtime "ordax-internet-proof"
exec_ordax_physical_proof "ordax-internet-proof" "$COLLECTOR" "$@"
