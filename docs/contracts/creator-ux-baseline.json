{
  "$schema": "prototype-ordax.creator-ux-baseline/1",
  "status": "minimum-rufus-class-baseline",
  "primary_flow": [
    "detect_usb",
    "select_usb",
    "create_ordax",
    "confirm_destructive_action",
    "windows_uac",
    "write",
    "readback_verify",
    "complete"
  ],
  "user_selectable_inputs": [
    "usb_target"
  ],
  "forbidden_required_inputs": [
    "iso_path",
    "image_path",
    "partition_scheme",
    "filesystem",
    "bootloader",
    "release_channel",
    "terminal_command",
    "publisher_key"
  ],
  "requirements": {
    "automatic_update_check_on_launch": true,
    "visible_update_control": true,
    "separate_usb_refresh_control": true,
    "post_uac_status_transition": true,
    "visible_progress_indicator": true,
    "progress_completes_on_success": true,
    "explicit_success_completion_notice": true,
    "single_usb_auto_selection": true,
    "multiple_usb_explicit_selection": true,
    "system_disk_exclusion": true,
    "destructive_confirmation": true,
    "readback_verification": true,
    "guided_step_experience": true,
    "destructive_review_explains_usb_erasure": true,
    "internal_disk_safety_explained": true,
    "write_state_warns_keep_usb_connected": true,
    "completion_explains_boot_from_usb": true,
    "illustration_slots_are_presentation_only": true,
    "native_visual_step_rail": true,
    "native_state_illustration": true,
    "visuals_follow_guided_state_machine": true,
    "visuals_add_no_network_or_web_runtime_dependency": true,
    "owner_write_package_independent_from_creator_dev": true,
    "owner_distribution_is_single_standalone_executable": true,
    "owner_distribution_requires_no_zip_extraction": true,
    "owner_elevated_backend_is_same_creator_build": true,
    "physical_write_has_single_uac_elevation_boundary": true,
    "owner_update_artifact_is_standalone_executable": true,
    "owner_update_applies_inside_creator": true,
    "owner_update_validates_sha256_and_size": true,
    "owner_update_blocks_downgrade": true,
    "owner_update_restarts_automatically": true,
    "owner_update_has_automatic_rollback": true
  }
}
