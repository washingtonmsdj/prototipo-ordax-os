{
  "$schema": "prototype-ordax.public-identity-gateway/1",
  "status": "real-auth-and-account-sync-gateway-v5-deployed-browser-form-and-api-dual-mode-activation-gated",
  "runtime": {
    "entrypoint": "services/public-identity/gateway.py:application",
    "protocol": "WSGI",
    "external_dependencies": false,
    "listener_owned_here": false,
    "provider_adapter": "supabase-password-and-sync-rest",
    "provider_configuration": "runtime-environment",
    "deployed_edge_adapter": "infra/supabase/functions/ordax-account-gateway/index.ts",
    "deployed_edge_adapter_version": 5
  },
  "routes": [
    {
      "method": "GET",
      "path": "/auth/session",
      "unconfigured_status": 200,
      "purpose": "validated-session-state-and-refresh"
    },
    {
      "method": "GET",
      "path": "/auth/login",
      "unconfigured_status": 303,
      "purpose": "canonical-login-page"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "unconfigured_status": 503,
      "purpose": "password-login"
    },
    {
      "method": "GET",
      "path": "/auth/register",
      "unconfigured_status": 303,
      "purpose": "canonical-registration-page"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "unconfigured_status": 503,
      "purpose": "password-registration"
    },
    {
      "method": "POST",
      "path": "/auth/logout",
      "unconfigured_status": 303,
      "purpose": "revoke-session-and-clear-cookies"
    },
    {
      "method": "GET",
      "path": "/sync/snapshot",
      "unconfigured_status": 503,
      "purpose": "authenticated-atomic-sync-snapshot"
    },
    {
      "method": "GET",
      "path": "/sync/changes",
      "unconfigured_status": 503,
      "purpose": "authenticated-incremental-sync-pull"
    },
    {
      "method": "POST",
      "path": "/sync/mutate",
      "unconfigured_status": 503,
      "purpose": "authenticated-account-sync-mutation"
    },
    {
      "method": "GET",
      "path": "/sync/objects",
      "unconfigured_status": 503,
      "purpose": "legacy-authenticated-full-read-compatibility"
    }
  ],
  "baseline": {
    "provider_configured": false,
    "credential_collection": false,
    "anonymous_session_is_authenticated": false,
    "cache_control": "no-store",
    "remote_redirect_allowed": false,
    "cross_site_logout_allowed": false,
    "tokens_in_response_body_allowed": false,
    "provider_adapter_implemented": true,
    "http_only_session_cookies": true,
    "refresh_session_supported": true,
    "sync_gateway_implemented": true,
    "sync_tokens_exposed_to_surface": false,
    "sync_provider_rows_exposed_to_surface": false,
    "incremental_sync_cursor_implemented": true,
    "atomic_sync_snapshot_implemented": true,
    "subject_bound_client_checkpoint": true,
    "cross_site_state_changes_allowed": false,
    "csrf_state_change_protection": true,
    "browser_form_redirects_implemented": true,
    "json_api_mode_preserved": true
  },
  "deployment": {
    "same_origin_required_for_public_site": true,
    "tls_required_in_production": true,
    "reverse_proxy_or_platform_adapter_expected": true,
    "edge_gateway_deployed": true,
    "public_browser_same_origin_activated": false,
    "same_origin_adapter_source": "deploy/public-site/nginx.conf",
    "same_origin_adapter_source_ready": true,
    "same_origin_adapter_deployed": false
  }
}
