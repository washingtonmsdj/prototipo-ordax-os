{
  "$schema": "prototype-ordax.public-identity-gateway/1",
  "status": "real-password-session-flow-implemented-public-activation-gated",
  "runtime": {
    "entrypoint": "services/public-identity/gateway.py:application",
    "protocol": "WSGI",
    "external_dependencies": false,
    "listener_owned_here": false,
    "provider_adapter": "supabase-password",
    "provider_configuration": "runtime-environment"
  },
  "routes": [
    {
      "method": "GET",
      "path": "/auth/session",
      "unconfigured_status": 200,
      "purpose": "validated-session-state-and-refresh"
    },
    {
      "method": "GET",
      "path": "/auth/login",
      "unconfigured_status": 303,
      "purpose": "canonical-login-page"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "unconfigured_status": 503,
      "purpose": "password-login"
    },
    {
      "method": "GET",
      "path": "/auth/register",
      "unconfigured_status": 303,
      "purpose": "canonical-registration-page"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "unconfigured_status": 503,
      "purpose": "password-registration"
    },
    {
      "method": "POST",
      "path": "/auth/logout",
      "unconfigured_status": 303,
      "purpose": "revoke-session-and-clear-cookies"
    }
  ],
  "baseline": {
    "provider_configured": false,
    "credential_collection": false,
    "anonymous_session_is_authenticated": false,
    "cache_control": "no-store",
    "remote_redirect_allowed": false,
    "cross_site_logout_allowed": false,
    "tokens_in_response_body_allowed": false,
    "provider_adapter_implemented": true,
    "http_only_session_cookies": true,
    "refresh_session_supported": true
  },
  "deployment": {
    "same_origin_required_for_public_site": true,
    "tls_required_in_production": true,
    "reverse_proxy_or_platform_adapter_expected": true
  }
}
