{
  "$schema": "prototype-ordax.portable-v3-one-shot-qemu-proof-spec/1",
  "status": "candidate-proof-not-yet-promoted",
  "product_scope": "stable-mvp-usb-only",
  "workflow": ".github/workflows/portable-v2-qemu-boot-proof.yml",
  "runner": "bootstrap/portable-v2/qemu_boot.py",
  "proof_mode": "armed-candidate-one-shot-fallback",
  "source_identity": {
    "candidate": "exact-current-head",
    "previous": "exact-pr-base-or-main-parent",
    "previous_source_tree_required": true,
    "same_ephemeral_ci_trust_required": true,
    "content_addressed_surface_runtime_reuse_required": true
  },
  "required_sequence": [
    "build-and-sign-candidate-release-v3",
    "build-and-sign-previous-release-v3-from-real-previous-source-tree",
    "arm-ext4-activation-state-with-ordax-portable-state-prepare",
    "boot-candidate-exactly-once",
    "do-not-promote-candidate",
    "boot-again-on-the-same-disposable-disk",
    "select-previous-current-release",
    "sync-inner-state-and-outer-data-filesystem-before-proof-handoff",
    "persist-candidate-as-rejected",
    "remove-candidate-advisory-file",
    "remove-activation-transaction"
  ],
  "required_final_state": {
    "current": "previous",
    "known_good": "previous",
    "rejected": "candidate",
    "candidate_file": "absent",
    "activation_transaction": "absent"
  },
  "safety": {
    "qemu_network": "disabled",
    "physical_target_device_touched": false,
    "physical_write_authorized": false,
    "public_physical_promotion_allowed": false,
    "guest_disk_retained": false,
    "cold_health_commit_proven": false,
    "physical_usb_boot_proven": false,
    "secure_boot_proven": false,
    "qemu_disk_cache_mode": "directsync",
    "final_state_inspection": "read-only-copy-fail-closed",
    "activation_state_outer_sync_required": true,
    "activation_state_durable_serial_marker": "ORDAX_PORTABLE_ACTIVATION_STATE_DURABLE=YES",
    "qemu_termination_requires_durable_state_marker": true
  },
  "promotion_effect": {
    "baseline_current_boot_contract_unchanged": true,
    "one_shot_failure_fallback_ci_gate_can_be_closed_after_exact-main-proof": true,
    "cold_health_commit_gate_closed": false,
    "physical_known_good_gate_closed": false,
    "physical_rollback_gate_closed": false
  }
}
