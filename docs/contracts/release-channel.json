{
  "$schema": "prototype-ordax.release-channel/1",
  "status": "canonical-prototype-contract",
  "source_authority": {
    "kind": "git",
    "repository": "washingtonmsdj/prototipo-ordax-os",
    "branch": "main"
  },
  "device_pre_release": {
    "full_git_client_required": false,
    "source_checkout_required": false,
    "compiler_required": false,
    "codex_required": false,
    "https_release_resolver_required": true,
    "public_trust_anchor_required": true
  },
  "release": {
    "exact_source_commit_required": true,
    "immutable_after_verification": true,
    "artifact_sha256_required": true,
    "artifact_size_required": true,
    "manifest_authenticity_required_before_production": true,
    "custom_crypto_allowed": false,
    "atomic_activation_required": true,
    "known_good_preservation_required": true,
    "offline_known_good_boot_required": true
  },
  "publication": {
    "ci_owned": true,
    "github_is_current_artifact_host": true,
    "github_is_only_allowed_future_host": false,
    "codex_required": false,
    "release_envelope_asset_name": "release-envelope.json",
    "latest_envelope_url": "https://github.com/washingtonmsdj/prototipo-ordax-os/releases/latest/download/release-envelope.json",
    "latest_pointer_is_delivery_selector_not_authenticity": true
  },
  "kernel": {
    "compiled_on_device": false,
    "compiled_in_repository_ci": true,
    "delivered_as_verified_artifact": true
  },
  "runtime_polling": {
    "profile": "stable-mvp",
    "owner": "system/supervisor",
    "default_interval_seconds": 60,
    "discovery_command": "ordax-release-agent inspect",
    "materialization_command": "ordax-release-agent materialize",
    "exact_expected_commit_required": true,
    "staged_root": "/ordax/releases/<source_commit>",
    "staged_state": "/state/ordax/staged-release-sha",
    "current_pointer_changed": false,
    "activation_performed": false,
    "reboot_requested": false,
    "git_required": false
  },
  "runtime_health_gate": {
    "profile": "stable-mvp",
    "owner": "system/supervisor",
    "candidate_source": "/ordax/releases/<source_commit>/system",
    "candidate_entrypoint": "surface/entrypoint",
    "system_entrypoint_invoked": false,
    "source_sha_must_match_candidate": true,
    "process_survival_required": true,
    "surface_health_required": true,
    "known_good_surface_restored_after_probe": true,
    "known_good_health_required_after_restore": true,
    "health_ready_state": "/state/ordax/stable-release-health-ready-sha",
    "health_rejected_state": "/state/ordax/stable-release-health-rejected-sha",
    "repeat_failed_candidate": false,
    "current_pointer_changed": false,
    "activation_performed": false,
    "reboot_requested": false
  }
}
