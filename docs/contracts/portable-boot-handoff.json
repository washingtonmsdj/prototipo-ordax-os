{
  "$schema": "prototype-ordax.portable-boot-handoff/1",
  "status": "disposable-mount-proof-only",
  "product_mode": "usb",
  "storage_profile": "portable-usb-v2",
  "release_manifest_schema": "prototype-ordax.release-manifest/2",
  "release_artifact": "system.erofs",
  "release_root": ".ordax/releases/<source_commit>",
  "persistent_state": ".ordax/state/persistent-state.img",
  "physical_boot_connected": false,
  "bootable_proven": false,
  "physical_write_authorized": false,
  "activation_selection_implemented": false,
  "rollback_selection_implemented": false,
  "initramfs_integration_implemented": false,
  "proof": {
    "owner": "bootstrap/portable-v2/proof.py",
    "requires_exact_offline_release_verification": true,
    "release_verifier_command": "ordax-release-agent verify-portable-exact",
    "regular_file_images_only": true,
    "host_loop_devices_only": true,
    "release_mount": {
      "filesystem": "erofs",
      "read_only": true
    },
    "state_mount": {
      "filesystem": "ext4",
      "read_write": true
    },
    "runtime_system_view": {
      "filesystem": "read-only-bind",
      "lower": "<mounted-system.erofs>/system",
      "merged": "temporary-proof-runtime-system",
      "persistent_upper": false
    },
    "checks": [
      "signed-release-exactly-reverified-offline-before-mount",
      "erofs-mounted-read-only",
      "persistent-state-mounted-ext4",
      "system-entrypoint-present-and-shell-valid",
      "runtime-write-survives-unmount-remount",
      "erofs-release-hash-unchanged-after-runtime-write",
      "no-current-symlink-created",
      "no-physical-device-path-accepted",
      "system-subtree-bind-mounted-read-only",
      "system-write-is-rejected",
      "persistent-ext4-state-survives-remount",
      "erofs-release-hash-unchanged-after-runtime-write-attempt"
    ]
  },
  "runtime_boundary": {
    "system_erofs_is_complete_rootfs": false,
    "system_erofs_contains_shared_product_system_tree": true,
    "minimal_os_base_remains_separate": true,
    "switch_root_to_system_erofs_allowed": false,
    "direct_exec_of_system_entrypoint_requires_portable_runtime_layout_support": true,
    "stable_runtime_layout": "portable-v2",
    "stable_runtime_layout_support_implemented": true,
    "stable_runtime_layout_owner": "system/entrypoint+system/supervisor",
    "verified_source_identity_env": "ORDAX_SOURCE_SHA",
    "runtime_layout_env": "ORDAX_STABLE_LAYOUT",
    "legacy_current_symlink_required": false,
    "portable_update_activation_connected": false,
    "portable_guardian_refresh_connected": false,
    "initial_surface_runtime_supported": true,
    "first_boot_network_required": false,
    "creator_preseeded_release_required": true,
    "bootstrap_capsule_verified_mount_implemented": false,
    "bootstrap_capsule_candidate_builder_implemented": true,
    "bootstrap_capsule_hash_pin_builder_support": true,
    "bootstrap_capsule_hash_pin_disposable_proof_implemented": true,
    "system_runtime_mutability": "immutable-release-tree",
    "system_persistent_overlay_allowed": false,
    "stable_base_overlay_required": true,
    "bootstrap_capsule_hash_pin_candidate_implemented": true,
    "bootstrap_capsule_hash_pin_pid1_enforced": false,
    "stable_base_is_complete_minimal_rootfs": true,
    "switch_root_target": "stable-base-overlay-root",
    "system_erofs_switch_root_target": false,
    "product_system_view": "read-only-bind",
    "mutable_base_owner": "ext4-persistent-state-image",
    "mutable_system_owner": null
  },
  "initramfs_integration_requirements": {
    "busybox_losetup_applet_required": true,
    "busybox_losetup_applet_currently_enabled": true,
    "portable_handoff_helper_required": true,
    "portable_handoff_helper_currently_installed": true,
    "ordax_data_exfat_mount_required": true,
    "exact_release_selection_metadata_required": true,
    "known_good_fallback_metadata_required": true,
    "selection_anti_rollback_policy_required": true,
    "busybox_mount_loop_currently_enabled": true,
    "busybox_exfat_volume_id_currently_enabled": true,
    "activation_state_reader_required": true,
    "activation_state_reader_currently_installed": true,
    "activation_state_reader_path": "/sbin/ordax-portable-state",
    "portable_handoff_helper_path": "/sbin/ordax-portable-mount",
    "portable_handoff_helper_pid1_connected": false,
    "portable_handoff_helper_selects_release": false,
    "portable_handoff_helper_verifies_signature": false,
    "portable_handoff_helper_writes_activation_state": false,
    "portable_handoff_helper_operations": [
      "mount-state",
      "mount-capsule",
      "mount-base",
      "mount-system"
    ],
    "activation_state_reader_operations": [
      "read-slot",
      "resolve",
      "select"
    ],
    "activation_selection_helper_implemented": true,
    "activation_selection_helper_pid1_connected": false,
    "activation_selection_order": [
      "current",
      "known-good"
    ],
    "candidate_is_boot_authority": false,
    "selection_requires_materialized_release_shape": true,
    "selection_signature_verification_delegated_to_release_agent": true,
    "bootstrap_capsule_hash_check_primitive_implemented": true,
    "bootstrap_capsule_hash_check_owner": "busybox-sha256sum",
    "bootstrap_capsule_mount_helper_implemented": true,
    "bootstrap_capsule_mount_read_only": true,
    "bootstrap_capsule_payload_shape_checked": true,
    "bootstrap_capsule_pid1_connected": false,
    "known_good_exact_resolver_implemented": true,
    "known_good_exact_resolver_verifies_materialized_shape": true,
    "known_good_exact_resolver_verifies_signature": false,
    "known_good_exact_resolver_signature_handoff": "ordax-release-agent verify-portable-exact",
    "capsule_hash_verification_helper_installed": true,
    "capsule_hash_verification_helper_path": "/sbin/ordax-portable-capsule-verify",
    "capsule_hash_verification_helper_pid1_connected": false,
    "capsule_hash_verification_fixed_paths": true,
    "capsule_hash_verification_mounts_capsule": false,
    "stable_base_hash_pin_builder_support": true,
    "stable_base_hash_pin_candidate_implemented": true,
    "stable_base_hash_verification_helper_installed": true,
    "stable_base_hash_verification_helper_path": "/sbin/ordax-portable-base-verify",
    "stable_base_hash_verification_helper_pid1_connected": false,
    "stable_base_pid1_hash_enforcement_implemented": false,
    "portable_candidate_pid1_installed": true,
    "portable_candidate_pid1_path": "/sbin/ordax-portable-init",
    "portable_candidate_pid1_default": false,
    "portable_candidate_pid1_disposable_invocation": "rdinit=/sbin/ordax-portable-init",
    "portable_candidate_pid1_physical_entry_implemented": false,
    "portable_candidate_pid1_current_then_known_good": true,
    "portable_candidate_pid1_exact_signature_verification": true,
    "portable_candidate_pid1_network_required": false
  },
  "forbidden": [
    "switch-root-directly-to-system.erofs",
    "trusting-release-filename-without-signed-exact-verification",
    "using-exfat-as-overlay-upper",
    "creating-legacy-current-symlink-on-exfat",
    "claiming-physical-boot-from-disposable-mount-proof",
    "physical-device-path-input"
  ],
  "activation_state": {
    "owner_filesystem": "ext4-persistent-state-image",
    "exfat_activation_pointer_allowed": false,
    "legacy_symlink_allowed": false,
    "root_after_state_mount": "/state/ordax/portable-release",
    "current_file": "/state/ordax/portable-release/current",
    "known_good_file": "/state/ordax/portable-release/known-good",
    "candidate_file": "/state/ordax/portable-release/candidate",
    "transaction_file": "/state/ordax/portable-release/activation-transaction.json",
    "identity_format": "lowercase-40-hex-source-commit",
    "writes_require_fsync": true,
    "directory_fsync_required": true,
    "atomic_replace_required": true,
    "current_must_reference_exact_verified_materialized_release": true,
    "known_good_must_reference_exact_verified_materialized_release": true,
    "candidate_is_not_boot_authority_until_promoted": true,
    "rollback_must_not_require_network": true,
    "selection_helper_implemented": true,
    "selection_helper_read_only": true,
    "selection_helper_order": [
      "current",
      "known-good"
    ],
    "selection_helper_candidate_ignored": true,
    "selection_helper_signature_authority": false,
    "exact_boot_slot_resolver_implemented": true,
    "exact_boot_slot_resolver_slots": [
      "current",
      "known-good"
    ],
    "exact_boot_slot_resolver_candidate_allowed": false
  },
  "boot_sequence_target": [
    "mount-ORDAX-ESP-read-only-for-bootstrap-substrate",
    "verify-and-mount-bootstrap-capsule",
    "mount-ORDAX-DATA-exfat",
    "attach-persistent-state-img-loop",
    "validate-ext4-state-before-writable-mount",
    "mount-persistent-state-ext4",
    "resolve-current-or-known-good-from-ext4-activation-state",
    "verify-selected-release-exactly-offline",
    "verify-stable-base-against-initramfs-owned-pin",
    "attach-stable-base-erofs-read-only",
    "compose-stable-base-overlay-with-ext4-upper-work",
    "attach-selected-system-erofs-read-only",
    "bind-verified-system-subtree-read-only",
    "switch-root-into-stable-base-overlay",
    "launch-ordax-stable-init-with-verified-portable-release-identity"
  ],
  "portable_bootstrap_contract": "docs/contracts/portable-bootstrap-v2.json",
  "pinned_initramfs_composition_proof": {
    "contract": "docs/contracts/portable-v2-pinned-initramfs-proof.json",
    "workflow_implemented": true,
    "proof_passed_on_current_head": false,
    "qemu_boot_proven": false,
    "physical_boot_proven": false
  },
  "qemu_direct_kernel_proof": {
    "contract": "docs/contracts/portable-v2-qemu-boot-proof.json",
    "workflow_implemented": true,
    "proof_passed_on_current_head": false,
    "direct_kernel_boot_proven": false,
    "uefi_boot_proven": false,
    "physical_boot_proven": false
  }
}
